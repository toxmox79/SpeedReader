{
  "name": "FocusFlash Speed Reader",
  "short_name": "FocusFlash",
  "description": "Lokaler Speed Reader fuer PDF-, EPUB- und Textdateien.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "background_color": "#f6f3ed",
  "theme_color": "#101820",
  "orientation": "any",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": ".",
      "accept": {
        "application/pdf": [".pdf"],
        "application/epub+zip": [".epub"],
        "text/plain": [".txt"]
      }
    }
  ]
}
